# ============================================================
# Copy to .env and fill in. .env is gitignored — keep it that way.
# NEVER commit real values.
# ============================================================

# --- data.gov.in ---
# Register free at https://www.data.gov.in -> My Account -> Generate API Key
# Do NOT use the public sample key: it caps responses at 10 records.
DATA_GOV_IN_API_KEY=replace_me
DATA_GOV_IN_BASE_URL=https://api.data.gov.in

# --- Database ---
POSTGRES_USER=bei
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=bei
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://bei:replace_me@localhost:5432/bei

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Pipeline politeness (be conservative; data.gov.in publishes no numeric limit) ---
HTTP_MAX_CONCURRENCY=4
HTTP_REQUESTS_PER_SECOND=2
HTTP_TIMEOUT_SECONDS=60
HTTP_MAX_RETRIES=5
USER_AGENT=BharatExpansionIntelligence/0.1 (open-data research project)

# --- Paths ---
BRONZE_PATH=./data/bronze
REFERENCE_PATH=./data/reference

# --- LLM (optional; app must work without it) ---
LLM_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000
